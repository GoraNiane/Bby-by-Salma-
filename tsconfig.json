{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strict": false
  },
  "include": [
    "api/**/*.ts",
    "backend/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/dist"
  ]
}
